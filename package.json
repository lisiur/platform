{
  "name": "platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "gen-version": "node scripts/gen-version.mjs",
    "prepare": "node scripts/gen-version.mjs",
    "predev": "node scripts/gen-version.mjs",
    "prebuild": "node scripts/gen-version.mjs",
    "dev": "NODE_OPTIONS='--max-old-space-size=8192' pnpm --filter './apps/*' --stream dev",
    "dev:gateway": "NODE_OPTIONS='--max-old-space-size=8192' pnpm --filter ./apps/gateway --stream dev",
    "dev:admin": "NODE_OPTIONS='--max-old-space-size=8192' pnpm --filter ./apps/admin --filter ./apps/gateway --stream dev",
    "dev:organization": "NODE_OPTIONS='--max-old-space-size=8192' pnpm --filter ./apps/organization --filter ./apps/gateway --stream dev",
    "dev:admin:studybuddy": "NODE_OPTIONS='--max-old-space-size=8192' pnpm --filter ./apps/admin --filter ./apps/studybuddy --filter ./apps/gateway --stream dev",
    "dev:studybuddy": "NODE_OPTIONS='--max-old-space-size=8192' pnpm --filter ./apps/studybuddy --filter ./apps/gateway --stream dev",
    "dev:qianlai": "NODE_OPTIONS='--max-old-space-size=8192' pnpm --filter ./apps/qianlai --filter ./apps/gateway --stream dev",
    "build": "pnpm --filter @repo/updater build && node scripts/build-apps.mjs",
    "build:server": "pnpm --filter @repo/updater build && NODE_OPTIONS=\"--max-old-space-size=512\" UV_THREADPOOL_SIZE=1 node scripts/build-apps.mjs",
    "clean:next": "find apps -name .next -type d -prune -exec rm -rf {} +",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "db:reset:danger": "pnpm --filter @repo/service db:reset:danger",
    "db:generate": "pnpm --filter @repo/service db:generate",
    "db:push": "pnpm --filter @repo/service db:push",
    "db:migrate": "pnpm --filter @repo/service db:migrate",
    "db:migrate:deploy": "pnpm --filter @repo/service db:migrate:deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}

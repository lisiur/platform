# Copy this file to .env.production and fill in real values.
# .env.production is gitignored and read by ecosystem.config.cjs (PM2).

# Deploy runbook: npm install && npm run migrate && npm run start
# Redeploy:      npm run migrate && npm run reload

# --- Database (required) ---
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/platform

# --- Database pool & timeouts (optional) ---
# Max connections in the pool (default 10)
# DATABASE_POOL_MAX=10
# Server-side per-query timeout in ms (default 30000)
# DATABASE_STATEMENT_TIMEOUT_MS=30000
# Aborts idle-in-transaction sessions after this many ms (default 30000)
# DATABASE_IDLE_TXN_TIMEOUT_MS=30000
# Connection attempt timeout in ms (default 5000)
# DATABASE_CONNECT_TIMEOUT_MS=5000

# --- App SSR API origin (required) ---
# Server-side (RSC/SSR) calls from the admin/organization apps reach the gateway
# here. Single-host PM2/nginx layout → the gateway on 127.0.0.1:3000.
API_ORIGIN=http://127.0.0.1:3000

# --- App SSR rate-limit bypass (required) ---
# Shared secret sent as X-Internal-Token on server-side (SSR) API calls so the
# rate limiter can exempt them. Must be identical on the apps and the service.
# Browser bundles never see this value (no NEXT_PUBLIC_ prefix).
SSR_API_TOKEN=replace-with-a-long-random-string

# --- AI Agent internal API calls (required for agent call_api) ---
# Secret sent as X-Internal-Token on the agent's call_api loopback requests so
# the operation logger attributes them to source: "agent" instead of "browser".
# Only needs to be set on the service (gateway).
AGENT_API_TOKEN=replace-with-a-different-random-string

# --- CORS (required in production) ---
# Comma-separated list of allowed origins. In production the service fails
# closed (no cross-origin allowed) when this is unset.
CORS_ALLOWED_ORIGINS=https://your-domain.com

# --- Data directory ---
# Base path for on-disk data. Uploads are stored under $DATA_DIR/uploads and
# agent file staging under $DATA_DIR/agent-attachments.
# In production, point this at a persistent location (e.g. a data volume);
# in development it defaults to the process working directory if unset.
# DATA_DIR=/data/platform
UPLOAD_SIGN_SECRET=replace-with-a-long-random-string

# --- Optional: rate limiting ---
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_GLOBAL_MAX=300
# RATE_LIMIT_GLOBAL_WINDOW_MS=60000
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_AUTH_WINDOW_MS=60000
# RATE_LIMIT_TRUST_PROXY=uniqueLocal,loopback,linkLocal

# --- Optional: jobs & cache ---
# JOB_CONCURRENCY=5
# CACHE_MAX_SIZE=1000

# --- Optional: System config env fallback ---
# Every SystemConfig group honors DB-authoritative / env-fallback resolution:
# the Settings UI (DB) is authoritative; these env vars only apply when the
# corresponding DB value is empty/missing. Env var names derive mechanically
# from `${GROUP}_${KEY}` (dots → _, camelCase → snake, uppercased).
#
# AI Agent (group: ai-agent):
# AI_AGENT_BASE_URL=
# AI_AGENT_API_KEY=
# AI_AGENT_MODEL=
# AI_AGENT_REASONING=
#
# AI Agent visual (group: ai-agent-ui) — controls chat UI visibility.
# Set to "true" to show; unset defaults to not shown.
# AI_AGENT_UI_SHOW_REASONING=
# AI_AGENT_UI_SHOW_TOOL_CALLS=
#
# WebAuthn (group: webauthn):
# WEBAUTHN_RP_NAME=
# WEBAUTHN_RP_ID=
# WEBAUTHN_ORIGIN=
# WEBAUTHN_ENABLED=
#
# WeChat (group: wechat):
# WECHAT_APPID=
# WECHAT_SECRET=
#
# Auth (group: auth):
# AUTH_REGISTRATION_ENABLED=
# AUTH_SESSION_MAX_AGE=604800   # seconds (604800 = 7 days)

# --- Optional: boot-time seeding ---
# The service self-seeds reference data (permissions, menus, roles, ...) on
# boot. Idempotent and safe to run repeatedly. Set to false to skip.
# SEED_ON_BOOT=false

# --- Optional: in-app self-update (OTA) ---
# Enables POST /api/version/update, which downloads a release tarball from the
# configured update source, extracts it over this deploy dir (preserving
# .env.production), runs migrations, and reloads PM2. Off by default; enable
# explicitly once the host is wired (pm2 on PATH, deploy dir writable by the app
# user).
#
# These can also be configured through the admin UI (Settings > Self Update).
# DB values take priority; env vars serve as fallbacks for empty DB rows.
#
# SELF_UPDATE_ENABLED=true
# Required when enabled: github or manifest.
# SELF_UPDATE_SOURCE=github
# GitHub source: repo to check/download from (default: lisiur/platform).
# SELF_UPDATE_GITHUB_REPO=lisiur/platform
# Optional token for private repos or to raise API rate limits.
# SELF_UPDATE_GITHUB_TOKEN=
# Optional reverse proxy to accelerate GitHub asset downloads (e.g. https://ghproxy.net).
# SELF_UPDATE_GITHUB_PROXY=
# Manifest source: latest release JSON and tagged release URL template.
# SELF_UPDATE_MANIFEST_URL=https://updates.example.com/platform/latest.json
# SELF_UPDATE_RELEASE_URL_TEMPLATE=https://updates.example.com/platform/{tag}.json
# Optional bearer token for manifest endpoints.
# SELF_UPDATE_AUTH_TOKEN=

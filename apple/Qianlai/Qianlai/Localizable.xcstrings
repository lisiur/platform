    "A balanced entry against the system equity account is posted automatically. Entries after the as-of date are left untouched." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A balanced entry against the system equity account is posted automatically. Entries after the as-of date are left untouched."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将自动生成一笔与系统权益账户对冲的平衡分录。截至日期之后的流水不会被改动。"
          }
        }
      }
    },
    "A liability balance is the amount you owe." : {
      "extractionState" : "manual",

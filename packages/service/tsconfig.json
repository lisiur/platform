{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "composite": true,
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*"],
      "#generated/*": ["./prisma/generated/*"],
      "#extractors/*": ["./src/shared/extractors/*"],
      "#lib/*": ["./src/shared/lib/*"],
      "#middleware/*": ["./src/shared/middleware/*"],
      "#modules/*": ["./src/modules/*"],
      "#shared/*": ["./src/shared/*"],
      "#states": ["./src/shared/states/index.ts"],
      "#states/*": ["./src/shared/states/*"],
      "#types/*": ["./src/shared/types/*"],
      "#utils/*": ["./src/shared/utils/*"]
    }
  },
  "include": ["src/**/*", "prisma/generated/**/*", "prisma/load-env.ts"],
  "exclude": ["node_modules"]
}

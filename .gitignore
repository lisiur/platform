# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# deploy artifacts (output of scripts/assemble.sh)
/deploy/
*.tar.gz

# misc
.DS_Store
*.pem

# uploads
/apps/admin/uploads/
/apps/gateway/uploads/

# agent plans/specs
/docs/superpowers/
/.codegraph/
/.opencode/
/.understand-anything/

# git worktrees
/worktrees/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# database
dev.db

# generated app version (from scripts/gen-version.mjs)
/packages/shared/src/version.ts

# env: bare .env holds non-sensitive shared defaults (committed); secret
# variants (.env.local, .env.production, …) are ignored.
.env.*
!.env.example
!.env.production.example
# packages/service/.env holds local dev secrets — keep ignored.
/packages/service/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/prisma/generated

.qoder

# xcode user state
xcuserdata/

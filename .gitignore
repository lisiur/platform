/worktrees/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# database
dev.db

# generated app version (from scripts/gen-version.mjs)
/packages/shared/src/version.ts

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example
!apps/admin/.env
!apps/gateway/.env
!apps/organization/.env
!apps/studybuddy/.env

